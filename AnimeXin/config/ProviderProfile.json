{
  "schema": "agoose-provider-profile-v1",
  "provider": "AnimeXin",
  "websiteKey": "AnimeXin",
  "remote": {
    "websiteJsonUrl": "https://raw.githubusercontent.com/RomantiKode/NoBarDig/main/Website.json"
  },
  "defaults": {
    "mainUrl": "https://animexin.dev"
  },
  "homepage": [
    {
      "source": "latest",
      "key": "home:latest",
      "title": "Latest Release",
      "heading": "Latest Release",
      "itemSelector": ".bsx"
    },
    {
      "source": "recommendation",
      "key": "home:recommendation",
      "title": "Recommendation",
      "heading": "Recommendation",
      "itemSelector": ".bsx"
    },
    {
      "source": "movies",
      "key": "home:movies",
      "title": "New Movie",
      "heading": "New Movie",
      "itemSelector": "li"
    }
  ],
  "endpoints": {
    "searchPath": "/",
    "searchParam": "s"
  },
  "selectors": {
    "homepageReleaseRoot": "div.releases",
    "homepageHeading": "h3",
    "searchCards": ".listupd .bsx",
    "singleInfo": ".single-info",
    "allEpisodesLink": ".naveps a[aria-label=All Episodes]",
    "mirrorOptions": "select.mirror option[value]",
    "mirrorRoot": "select.mirror",
    "detailTitle": ".animefull .infox h1, .single-info .infox h2",
    "entryTitle": "h1.entry-title",
    "originalTitle": ".alter",
    "poster": ".bigcontent .thumb img, .single-info .thumb img",
    "genres": ".genxed a",
    "movieEpisodeLink": ".epcheck .eplister li a[href]",
    "cardAnchor": "a.tip[href], a[href]",
    "cardTitle": ".tt h2",
    "cardImage": "img[src]",
    "cardTypeBadge": ".typez, .eggtype",
    "movieListAnchor": ".leftseries h4 a.series[href], .imgseries a.series[href]",
    "movieListTitle": ".leftseries h4 a.series",
    "movieListImage": ".imgseries img[src]",
    "infoRoot": ".animefull .spe, .single-info .spe",
    "plotRoot": ".animefull .entry-content, .single-info .infox .entry-content",
    "episodeItems": ".epcheck .eplister ul li",
    "episodeLink": "a[href]",
    "episodeNumber": ".epl-num",
    "episodeTitle": ".epl-title",
    "rating": ".animefull .rating strong, .single-info .rating strong",
    "mirrorIframe": "iframe[src]"
  },
  "playback": {},
  "contentFilter": {
    "blockedCategories": [],
    "blockedTags": []
  }
}
