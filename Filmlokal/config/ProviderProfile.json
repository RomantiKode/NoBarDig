{
  "schema": "agoose-provider-profile-v1",
  "provider": "Filmlokal",
  "websiteKey": "Filmlokal",
  "remote": {
    "websiteJsonUrl": "https://raw.githubusercontent.com/mj1Per127/agoosecloudstream/main/Website.json"
  },
  "defaults": {
    "mainUrl": "https://tv1.filmlokal.me"
  },
  "homepage": [
    {
      "source": "featured/",
      "key": "featured",
      "title": "Film Terpopuler"
