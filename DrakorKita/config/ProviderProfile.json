{
  "schema": "agoose-provider-profile-v1",
  "provider": "DrakorKita",
  "websiteKey": "DrakorKita",
  "remote": {
    "websiteJsonUrl": "https://raw.githubusercontent.com/mj1Per127/agoosecloudstream/main/Website.json"
  },
  "defaults": {
    "mainUrl": "https://drakor.kita.mobi"
  },
  "homepage": [
    {
      "source": "Eps Terbaru",
      "key": "Eps Terbaru",
      "title": "Eps Terbaru"
    },
    {
      "source": "Movie Terbaru",
      "key": "Movie Terbaru",
      "title": "Movie Terbaru"
    },
    {
      "source": "Serie Terbaru",
      "key": "Serie Terbaru",
      "title": "Serie Terbaru"
    }
  ],
  "endpoints": {
    "searchPath": "/all",
    "searchParam": "q"
  },
  "selectors": {
    "homepageHeading": "h4.heading1",
    "cardLink": "a.poster[href]",
    "detailHeading": "h3.heading1",
    "genreLinks": ".gnr a",
    "synopsis": ".sinopsis .desc-wrap p",
    "poster": ".bigcontent .thumb img[src]",
    "background": ".bigcover img[src]",
    "originalTitle": ".alter",
    "playerIframe": "#ploader iframe[src]",
    "episodeAnchor": "#episode_lists a[data-epid]",
    "infoRows": "ul.anf > li",
    "detailIdentity": "h3.heading1 span",
    "cardType": "span.type",
    "cardTitle": "span.titit",
    "cardPoster": "img.poster[src], img[src]"
  },
  "playback": {
    "maxPageHops": 12,
    "dispatcherTimeoutMs": 15000,
    "episodeTimeoutMs": 20000,
    "wrapperTimeoutMs": 25000
  },
  "classification": {
    "providerParentDomains": [
      "kita.mom",
      "kita.baby",
      "nicewap.sbs"
    ],
    "playerHosts": [
      "drakorkita.stream"
    ]
  },
  "contentFilter": {
    "blockedCategories": [],
    "blockedTags": []
  }
}
