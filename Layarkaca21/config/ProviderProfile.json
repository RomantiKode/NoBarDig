  "selectors": {
    "homepageWidgetTemplate": ".widget[data-type=\"{key}\"]",
    "seriesMarker": "#season-data",
    "playerMarker": "#player-list",
    "activeEpisode": "ul.episode-list a.active[href]",
    "cardRoot": "a",
    "cardPoster": ".poster",
    "cardTitle": ".poster-title",
    "cardGenre": ".genre",
    "cardYear": ".year",
    "cardImage": "img",
    "cardEpisode": ".episode",
    "watchHistory": "#watch-history-data",
    "detailHeading": ".movie-info h1",
    "detailPoster": ".detail.hidden img",
    "ogImage": "meta[property=og:image]",
    "synopsis": ".synopsis",
    "infoTags": ".info-tag span",
    "genreLinks": ".tag-list a[href^='/genre/']",
    "tagLinks": ".tag-list a[href^='/tag/']",
    "detailParagraphs": ".detail.hidden p",
    "jsonLd": "script[type='application/ld+json']",
    "trailerAnchors": "a.yt-lightbox[href]",
    "trailerIframes": "iframe[src*='youtube.com/embed'], iframe[src*='youtube-nocookie.com/embed']",
    "playerAnchors": "#player-list a[data-url], #player-list a[href]",
    "playerOptions": "#player-select option[value]",
    "mainPlayerIframe": "iframe#main-player[src]",
    "episodeLinks": "ul.episode-list a[href]",
    "seriesPlaybackMarkers": "#season-data, ul.episode-list a[href]"
  },
  "playback": {
    "sourceMode": "auto",
    "serverResolveTimeoutMs": 20000,
    "maxPageHops": 3,
    "wrapperTimeoutMs": 20000,
    "mediaRequestRegex": "(?i)(?:\\.m3u8|\\.mp4)(?:[?#]|$)",
    "runtimeDiscovery": {
      "enabled": true,
      "timeoutMs": 20000
    },
    "offline": {
      "enabled": false,
      "mediaSource": "",
      "label": "SOURCE VIDEO OFFLINE"
    },
    "primaryWrapperHost": "videonode.de",
    "detectedPlayerHosts": [
      "videonode.de",
      "www.youtube.com"
    ]
  },
  "metadata": {
    "tmdb": {
      "enabled": true,
      "language": "id-ID",
      "descriptionPolicy": "prefer_indonesian",
      "invalidWebDescriptionFallback": "empty",
      "descriptionQuality": {
        "enabled": true
      }
    },
    "descriptionFilter": {
      "enabled": true,
      "genericRules": true,
      "boundaryMarkers": [],
      "stripPatterns": [],
      "invalidPatterns": [],
      "allowPatterns": [],
      "minimumCleanLength": 40
    }
  },
  "diagnostics": {
    "enabled": true
  },
  "contentFilter": {
    "blockedCategories": [],
    "blockedTags": []
  },
  "labels": {
    "actorPrefix": "Bintang Film"
  }
}
