  },
  "homepage": [
    {
      "source": "movie",
      "key": "latest-movies",
      "title": "Film Terbaru"
    },
    {
      "source": "series",
      "key": "latest-series",
      "title": "Series Terbaru"
    },
    {
      "source": "movie",
      "key": "top-series-today",
      "title": "Series Unggulan"
    },
    {
      "source": "movie",
      "key": "latest-action",
      "title": "Action Terbaru"
    },
    {
      "source": "movie",
