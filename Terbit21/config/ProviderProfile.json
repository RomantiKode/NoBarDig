{
  "schema": "agoose-provider-profile-v1",
  "provider": "Terbit21",
  "websiteKey": "Terbit21",
  "remote": {
    "websiteJsonUrl": "https://raw.githubusercontent.com/mj1Per127/agoosecloudstream/main/Website.json"
  },
  "defaults": {
    "mainUrl": "https://terbit21.net",
    "origins": [
      "https://terbit21.net",
      "https://terbit21.media",
      "https://terbit21.org"
    ],
    "historicalOrigin": "https://162.244.95.227"
  },
  "homepage": [
    {"source": "/", "key": "latest", "title": "Terbaru"},
    {"source": "/tv/", "key": "tv", "title": "Drama"},
    {"source": "/best-rating/", "key": "best-rating", "title": "Best Rating"},
    {"source": "/country/china/", "key": "china", "title": "Drama China"}
  ],
  "endpoints": {
    "searchParam": "s",
    "searchModeParam": "search",
    "searchModeAdvancedValue": "advanced",
    "paginationSegment": "page"
  },
  "selectors": {
    "targetFingerprintAssets": "link[href*='/wp-content/themes/muvipro/'], link[href*='/wp-content/plugins/idmuvi-core/']",
    "targetFingerprintLayout": "#gmr-main-load, .gmr-mainmenu, .gmr-server-wrap, .gmr-listseries",
    "liveSearchEvidence": "input[placeholder*='Cari Judul'], input[placeholder*='IMDb'], input[name=s]",
    "targetCards": "#gmr-main-load article.item, article.item",
    "paginationNext": "a.next.page-numbers, .pagination a.next[href], a[rel=next][href]",
    "targetCardLink": "h2.entry-title a[href]",
    "targetCategories": ".gmr-movie-on a, a[href*='/genre/'], a[href*='/category/']",
    "episodeLinks": ".gmr-listseries a.button.button-shadow[href*='/eps/'], .gmr-listseries a[href*='/eps/'], a[href*='/eps/']",
    "serverTabs": ".muvipro-player-tabs a[href]",
    "playerFrames": "iframe[src], frame[src]",
    "detailTitle": "h1.entry-title[itemprop=name], h1.entry-title, h1[itemprop=name], h1",
    "detailMetadata": ".entry-content-single .gmr-moviedata",
    "trailerPopup": "a.gmr-trailer-popup[href]",
    "trailerYoutube": "a[href*='youtube.com/watch'], a[href*='youtu.be/'], iframe[src*='youtube.com/embed/']"
  },
  "playback": {
    "maxServerPages": 8,
    "maxPlayerCandidates": 24,
    "maxPageHops": 2
  },
  "classification": {
    "excludedPlaybackHostHints": [
      "facebook.com/plugins/comments",
      "youtube.com/embed",
      "youtu.be/",
      "doubleclick.net",
      "googlesyndication.com",
      "google-analytics.com",
      "googletagmanager.com"
    ]
  },
  "contentFilter": {
    "blockedCategories": [],
    "blockedTags": []
  }
}
